# Copy to .env and fill in. Never commit real values.

# Public HTTPS URL that Wasiliana posts to (ngrok for the demo, or the D2 host).
USSD_PUBLIC_URL=https://example.ngrok-free.app/ussd

# Backend contract (docs/API_CONTRACT.md §5). Leave BACKEND_BASE_URL empty to use DevBackend.
BACKEND_BASE_URL=https://backend.example/ngao/v1
USSD_SERVICE_TOKEN=
BACKEND_TIMEOUT_S=4

# Optional shared secret: Wasiliana callback URL becomes .../ussd?k=<WEBHOOK_SECRET>
WEBHOOK_SECRET=

# Autonomous Database (USSD_SESSIONS write; SUBSCRIBERS + WARDS read). Empty = in-memory dev store.
DB_USER=NGAO
DB_PASSWORD=
DB_DSN=
DB_WALLET_DIR=
DB_WALLET_PASSWORD=

# Wasiliana payload. Confirm against docs.wasiliana.com and override if they differ.
WASILIANA_TEXT_MODE=cumulative
WASILIANA_FIELD_SESSION=
WASILIANA_FIELD_PHONE=
WASILIANA_FIELD_TEXT=
WASILIANA_FIELD_SERVICE_CODE=
